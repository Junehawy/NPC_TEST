build/
build-*/
src/main
*.o
*.a
*.so

# Godot 集成示例：扩展产物与导入缓存不入库
game_adapter/godot_demo/bin/
game_adapter/godot_demo/.godot/
# Godot 4.4+ 的 .import 侧车文件已废弃（导入元数据在 .godot/），不入库
game_adapter/godot_demo/**/*.import
# 第三方 Godot 插件不入库（含大体积二进制，如 ziva_agent/CEF 约 444MB）；
# 需要入库某插件时，删除下面一行并显式 git add 该目录
game_adapter/godot_demo/addons/
# 门禁 Godot 冒烟的沙箱 XDG 重定向目录
.tmp-godotdata/
.tmp-godotconfig/
# 临时/外来目录（.tmp-* 一律不入库）
.tmp-*/
# agent 工作记忆（跨会话状态存根，不入库）
.agent-pending.md
# 视觉验证截屏/录屏产物
.demo-shots/
